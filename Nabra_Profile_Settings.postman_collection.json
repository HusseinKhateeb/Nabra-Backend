{
  "info": {
    "name": "Nabra - Profile & Settings",
    "description": "Profile and Settings Endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"confirmPassword\": \"SecurePass123!\",\n  \"displayName\": \"أحمد محمد\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "👤 Profile",
      "item": [
        {
          "name": "Get Profile (مع الإحصائيات من DB)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/users/profile",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "users", "profile"]
            },
            "description": "جلب ملف المستخدم الشخصي مع الإحصائيات المحسوبة من Database:\n- عدد الجلسات (sessions count)\n- عدد المحادثات (chats count)\n- نسبة النجاح (accuracy %)"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"أحمد محمد جديد\",\n  \"gender\": \"male\",\n  \"age\": 25,\n  \"phoneNumber\": \"+972598765432\",\n  \"avatarUrl\": \"https://example.com/avatar.jpg\",\n  \"highContrastEnabled\": false,\n  \"fontScale\": 1.2,\n  \"vibrationEnabled\": true\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/users/profile",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "users", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "⚙️ Settings",
      "item": [
        {
          "name": "Get Settings (الإعدادات الحالية)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/users/settings",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "users", "settings"]
            },
            "description": "جلب إعدادات المستخدم الحالية:\n- اللغة المفضلة (preferredLanguage)\n- High Contrast Mode\n- حجم الخط (fontScale)\n- الاهتزاز (vibration)\n- الملف العام/الخاص (publicProfile)\n- عرض معلومات الاتصال\n- الإشعارات\n- مستوى جمع البيانات"
          }
        },
        {
          "name": "Update Settings",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"preferredLanguage\": \"ar\",\n  \"highContrastEnabled\": true,\n  \"fontScale\": 1.5,\n  \"vibrationEnabled\": false,\n  \"publicProfile\": true,\n  \"showContactInfo\": true,\n  \"allowNotifications\": true,\n  \"allowDataCollection\": false,\n  \"dataCollectionLevel\": \"minimal\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/users/settings",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "users", "settings"]
            }
          }
        }
      ]
    },
    {
      "name": "📋 Other User Endpoints",
      "item": [
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/users/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "users", "me"]
            }
          }
        },
        {
          "name": "List All Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/users",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "users"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": "your_jwt_token_here",
      "type": "string"
    }
  ]
}
